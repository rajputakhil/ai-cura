# Streamlit Cloud secrets template.
# On Streamlit Community Cloud, paste these into: App → Settings → Secrets
# (do NOT commit a real secrets.toml — it's gitignored).

# Optional: only needed if you want the Claude API backend in the deployed app.
ANTHROPIC_API_KEY = "sk-ant-..."

# Note: the local DeepSeek/Ollama backend does NOT work on Streamlit Cloud —
# there's no Ollama server there. Deployed = automated criteria + Claude (if key set).
# Local runs keep the full local-model comparison feature.
